# CoreMind Node — systemd user service
#
# BEFORE INSTALLING: update the paths below to match where you cloned the repo.
# Default assumes ~/core-mind — change to e.g. ~/Sandbox/core-mind if needed.
#
# Install on Raspberry Pi:
#   # 1. Edit WorkingDirectory and ExecStart below to match your repo path
#   mkdir -p ~/.config/systemd/user
#   cp <repo-path>/coremind/service/coremind.service ~/.config/systemd/user/coremind.service
#   systemctl --user daemon-reload
#   systemctl --user enable coremind
#   systemctl --user start coremind
#
# To edit an already-installed service:
#   systemctl --user edit --full coremind
#
# Start at boot without needing to log in first (run once):
#   loginctl enable-linger $USER
#
# Check logs:
#   journalctl --user -u coremind -f

[Unit]
Description=CoreMind Voice Assistant Node
# Wait for network (Tailscale needs it to reach the Hub) and sound subsystem
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# ── Update these two lines to match your repo location ──────────────────────
WorkingDirectory=%h/core-mind
ExecStart=%h/core-mind/.venv/bin/python -m coremind.main run
# ────────────────────────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
