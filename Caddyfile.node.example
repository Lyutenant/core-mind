# Caddyfile for CoreMind Node (Raspberry Pi)
#
# CoreMind Node MCP server binds to 127.0.0.1:8767 by default.
# Caddy listens on the Pi's Tailscale interface and allows only the Hub
# (Mac Mini); other tailnet devices get 403.
#
# Why the explicit `bind` directive (unlike the Hub's ":8765" wildcard)?
# A site address like "http://100.x.x.x:8767" only matches the Host
# header — Caddy still binds the wildcard 0.0.0.0:8767, which on Linux
# conflicts with the MCP server's 127.0.0.1:8767 bind ("address already
# in use"). The `bind` directive is what restricts the listener to the
# Tailscale interface. This means Caddy fails to start if Tailscale is
# not up yet — see docs/setup-node.md for the systemd ordering fix.
#
# Usage:
#   1. Install Caddy on the Pi: https://caddyserver.com/docs/install
#   2. Get the Pi's Tailscale IP:      tailscale ip -4        (→ 100.x.x.x)
#   3. Get the Mac Mini's Tailscale IP: run the same on the Mac (→ 100.y.y.y)
#   4. Replace both placeholders below
#   5. Install to /etc/caddy/Caddyfile and start (see docs/setup-node.md)
#
# In Hub config.yaml, set:
#   tools:
#     mcp_servers:
#       - name: node
#         transport: http
#         url: http://100.x.x.x:8767   # Pi's Tailscale IP

{
    auto_https off
}

:8767 {
    # Listen only on the Pi's Tailscale IP (avoids the 8767 port conflict)
    bind 100.x.x.x

    # Allow the Hub (Mac Mini, 100.y.y.y) + the Pi itself (100.x.x.x) for
    # local testing. Caddy only listens on the Tailscale IP, so a local
    # `curl http://100.x.x.x:8767` arrives from the Pi's own Tailscale
    # address — never from loopback.
    @hub remote_ip 100.x.x.x 100.y.y.y

    handle @hub {
        reverse_proxy 127.0.0.1:8767 {
            header_up Host localhost:8767
        }
    }

    respond "Forbidden" 403
}
